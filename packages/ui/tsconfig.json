{
  "extends": "@petpooja/typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["src/registry/lib/*"],
      "@/components/ui/*": ["src/registry/ui/*"],
      "@/registry/*": ["src/registry/*"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests", "vite.config.ts", "tailwind.config.ts", "tailwind.preset.ts"],
  "exclude": ["node_modules", "dist"]
}
